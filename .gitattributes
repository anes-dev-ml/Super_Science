# Normalize text files
* text=auto

# Source files use LF
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.txt text eol=lf
*.md text eol=lf
CMakeLists.txt text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.safetensors binary
*.gguf binary
*.onnx binary